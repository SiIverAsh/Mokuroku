# Bangumi Personal Access Token (https://next.bgm.tv/demo/access-token)
BGM_ACCESS_TOKEN=

# Optional: Bangumi username (auto-detected via /v0/me if omitted)
BGM_USERNAME=

# Optional: Custom data & cache paths (defaults to ./data and ./cache)
MOKUROKU_DATA_DIR=./data
MOKUROKU_CACHE_DIR=./cache

# Optional: Local dashboard bind address & port (bound to 127.0.0.1 only)
MOKUROKU_HOST=127.0.0.1
MOKUROKU_PORT=4173

# Optional: HTTP/HTTPS proxy if required for GitHub / Bangumi API access
# HTTPS_PROXY=http://127.0.0.1:7890
