{
  "name": "mokuroku",
  "version": "0.1.0",
  "description": "基于 Bangumi v0 在线 API 与轻量本地缓存的个人动画检索与看板",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "mokuroku": "./bin/mokuroku.mjs"
  },
  "scripts": {
    "mokuroku": "node --env-file-if-exists=.env --use-env-proxy ./node_modules/tsx/dist/cli.mjs src/cli.ts",
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "svelte-kit sync && tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "13.1.1",
    "cac": "^6.7.14"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "msw": "^2.7.0",
    "svelte": "^5.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
